# --- Fast Provider (Groq) ---
# Used for the Controller and Decomposer which must run multiple times per second
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
FAST_LLM_MODEL=llama-3.1-8b-instant

# --- Quality Provider (Gemini) ---
# Used for Final Synthesis where advanced reasoning is strictly graded
# Get a free key at Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
SYNTHESIS_LLM_MODEL=gemini-2.5-flash

# --- Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_S=10

# --- Request hardening (all optional; shown with safe defaults) ---
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
# Relevance floor for cross-encoder scores. Default -999 disables the floor;
# only set this after calibrating on your corpus (a stale value abstains on good evidence).
RELEVANCE_FLOOR=-999
# Model pricing in USD per 1M tokens (used only for telemetry estimates).
SYNTHESIS_PRICE_PER_M_INPUT=0.075
SYNTHESIS_PRICE_PER_M_OUTPUT=0.30
TELEMETRY_MAX_BYTES=10485760
