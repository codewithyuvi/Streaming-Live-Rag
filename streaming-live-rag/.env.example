# Default LLM Provider
LLM_PROVIDER=gemini

# Gemini API Key (required if LLM_PROVIDER=gemini)
# Get a key at Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant URL (defaults to local docker container)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Default Gemini model for fast controller/decomposition tasks (Gemini 1.5 Flash is extremely fast)
FAST_LLM_MODEL=gemini-3.8-flash

# Stronger model for final synthesis where reasoning quality matters most
SYNTHESIS_LLM_MODEL=gemini-3.8-pro
