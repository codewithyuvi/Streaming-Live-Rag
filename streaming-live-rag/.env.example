# --- Fast Provider (Groq) ---
# Used for the Controller and Decomposer which must run multiple times per second
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
FAST_LLM_MODEL=groq/compound-mini

# --- Quality Provider (Gemini) ---
# Used for Final Synthesis where advanced reasoning is strictly graded
# Get a free key at Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
SYNTHESIS_LLM_MODEL=gemini-3.8-pro

# --- Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
